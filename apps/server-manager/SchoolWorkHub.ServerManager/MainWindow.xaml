<Window x:Class="SchoolWorkHub.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolWorkHub 서버 관리자"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,12" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="RowHeaderWidth" Value="0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="84" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SchoolWorkHub" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="학교 업무 통합 서버 관리자" FontSize="13" Foreground="#DCEBFF" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="서버 주소" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White" />
          <TextBox Width="280"
                   Margin="0"
                   Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="연결 확인" Command="{Binding CheckConnectionCommand}" Margin="12,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#EAF2FD" Padding="20">
        <StackPanel>
          <TextBlock Text="서버 상태" FontSize="18" FontWeight="Bold" Margin="0,0,0,18" />
          <Border Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel>
              <TextBlock Text="API 생존 상태" Foreground="#64748B" />
              <TextBlock Text="{Binding LiveStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel>
              <TextBlock Text="DB 준비 상태" Foreground="#64748B" />
              <TextBlock Text="{Binding ReadyStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Separator Margin="0,8,0,20" />
          <TextBlock Text="운영 절차" FontWeight="Bold" Margin="0,0,0,10" />
          <TextBlock Text="1. 서버 연결 확인" Margin="0,5" />
          <TextBlock Text="2. 학교·관리자 생성" Margin="0,5" />
          <TextBlock Text="3. 관리자 로그인" Margin="0,5" />
          <TextBlock Text="4. 부서·역할·사용자 확인" Margin="0,5" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,22,28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
          <TabItem Header="초기 설정">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="학교 정보" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="학교 식별 코드는 영문, 숫자, 하이픈으로 입력하세요."
                               Margin="0,6,0,18" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="학교 코드" />
                    <TextBox Text="{Binding SchoolCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="학교 이름" />
                    <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="최고관리자" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="최초 계정은 전체 관리 권한을 갖습니다."
                               Margin="0,6,0,18" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="아이디" />
                    <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="표시 이름" />
                    <TextBox Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="비밀번호 (12자 이상)" />
                    <PasswordBox PasswordChanged="AdminPassword_OnPasswordChanged" />
                  </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                  <Button Content="학교와 최고관리자 생성"
                          Width="240"
                          HorizontalAlignment="Left"
                          Command="{Binding BootstrapCommand}" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="관리자">
            <Grid Margin="24">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="학교 코드" />
                    <TextBox Text="{Binding LoginSchoolCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="관리자 아이디" />
                    <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="비밀번호" />
                    <PasswordBox PasswordChanged="LoginPassword_OnPasswordChanged" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button Grid.Column="5" Content="로그인" Command="{Binding LoginCommand}" VerticalAlignment="Bottom" />
                  <Button Grid.Column="6" Content="목록 새로고침" Command="{Binding RefreshAdministrationCommand}" VerticalAlignment="Bottom" />
                </Grid>
              </Border>

              <TabControl Grid.Row="2">
                <TabItem Header="부서">
                  <DataGrid ItemsSource="{Binding Departments}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="180" />
                      <DataGridTextColumn Header="부서명" Binding="{Binding Name}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="역할">
                  <DataGrid ItemsSource="{Binding Roles}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="180" />
                      <DataGridTextColumn Header="역할명" Binding="{Binding Name}" Width="220" />
                      <DataGridCheckBoxColumn Header="시스템" Binding="{Binding IsSystem}" Width="90" />
                      <DataGridTextColumn Header="권한" Binding="{Binding PermissionCodes}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
                <TabItem Header="사용자">
                  <DataGrid ItemsSource="{Binding Users}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="아이디" Binding="{Binding Username}" Width="180" />
                      <DataGridTextColumn Header="이름" Binding="{Binding DisplayName}" Width="220" />
                      <DataGridCheckBoxColumn Header="활성" Binding="{Binding IsActive}" Width="80" />
                      <DataGridCheckBoxColumn Header="최고관리자" Binding="{Binding IsSuperuser}" Width="110" />
                      <DataGridTextColumn Header="부서 ID" Binding="{Binding DepartmentId}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </TabItem>
              </TabControl>
            </Grid>
          </TabItem>

          <TabItem Header="운영 상태">
            <StackPanel Margin="24">
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="기반 서비스" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="API와 PostgreSQL 상태를 실시간으로 확인합니다."
                             Margin="0,6,0,16" Foreground="#64748B" />
                  <Button Content="상태 새로고침"
                          Width="170"
                          HorizontalAlignment="Left"
                          Command="{Binding CheckConnectionCommand}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="후속 운영 기능" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="서비스 제어, 백업·복원, 업데이트·롤백은 운영 단계에서 순차 활성화됩니다."
                             Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
          <ProgressBar Height="4"
                       Margin="0,0,0,10"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Border Padding="16,12"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="#C7DCFA"
                  BorderThickness="1"
                  CornerRadius="8">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
