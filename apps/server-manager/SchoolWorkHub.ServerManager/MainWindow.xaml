<Window x:Class="SchoolWorkHub.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolWorkHub 서버 관리자"
        Width="1100"
        Height="760"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,12" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="84" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SchoolWorkHub" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="학교 업무 통합 서버 관리자" FontSize="13" Foreground="#DCEBFF" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="서버 주소" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White" />
          <TextBox Width="280"
                   Margin="0"
                   Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="연결 확인" Command="{Binding CheckConnectionCommand}" Margin="12,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#EAF2FD" Padding="20">
        <StackPanel>
          <TextBlock Text="서버 상태" FontSize="18" FontWeight="Bold" Margin="0,0,0,18" />
          <Border Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel>
              <TextBlock Text="API 생존 상태" Foreground="#64748B" />
              <TextBlock Text="{Binding LiveStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel>
              <TextBlock Text="DB 준비 상태" Foreground="#64748B" />
              <TextBlock Text="{Binding ReadyStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Separator Margin="0,8,0,20" />
          <TextBlock Text="진행 순서" FontWeight="Bold" Margin="0,0,0,10" />
          <TextBlock Text="1. 서버 연결 확인" Margin="0,5" />
          <TextBlock Text="2. 학교 정보 입력" Margin="0,5" />
          <TextBlock Text="3. 최고관리자 생성" Margin="0,5" />
          <TextBlock Text="4. 사용자·권한 구성" Margin="0,5" Foreground="#64748B" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="28,22,28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
          <TabItem Header="초기 설정">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="학교 정보" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="학교 식별 코드는 영문, 숫자, 하이픈으로 입력하세요."
                               Margin="0,6,0,18" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="학교 코드" />
                    <TextBox Text="{Binding SchoolCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="학교 이름" />
                    <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="최고관리자" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="최초 계정은 전체 관리 권한을 갖습니다."
                               Margin="0,6,0,18" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="아이디" />
                    <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="표시 이름" />
                    <TextBox Text="{Binding AdminDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="비밀번호 (12자 이상)" />
                    <PasswordBox PasswordChanged="AdminPassword_OnPasswordChanged" />
                  </StackPanel>
                </Border>

                <StackPanel Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,390,0,0">
                  <Button Content="학교와 최고관리자 생성"
                          Width="240"
                          HorizontalAlignment="Left"
                          Command="{Binding BootstrapCommand}" />
                  <ProgressBar Height="4"
                               Margin="0,12,0,0"
                               IsIndeterminate="True"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="운영 상태">
            <StackPanel Margin="24">
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="기반 서비스" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="API와 PostgreSQL 상태를 실시간으로 확인합니다."
                             Margin="0,6,0,16" Foreground="#64748B" />
                  <Button Content="상태 새로고침"
                          Width="170"
                          HorizontalAlignment="Left"
                          Command="{Binding CheckConnectionCommand}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="후속 운영 기능" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="서비스 제어, 백업·복원, 업데이트·롤백은 운영 단계에서 순차 활성화됩니다."
                             Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="16,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#C7DCFA"
                BorderThickness="1"
                CornerRadius="8">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
